# Adres platformy inwestorskiej (przycisk "Dla Inwestora")
NEXT_PUBLIC_INVESTOR_PLATFORM_URL=https://app.vesteri.com

# Kanoniczna domena strony (tagi hreflang / canonical)
NEXT_PUBLIC_SITE_URL=https://www.vesteri.com

# Token beacona Cloudflare Web Analytics (panel Cloudflare → Analytics & Logs →
# Web Analytics). Pusty = skrypt się nie ładuje, więc lokalne i podglądowe
# buildy nie zaśmiecają statystyk produkcyjnych.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Identyfikator portalu HubSpot (kod śledzący). Domyślnie 147800534.
# Ustaw pusty ciąg lokalnie, jeśli nie chcesz wysyłać ruchu deweloperskiego
# do HubSpota. UWAGA: kod śledzący stawia cookies wymagające zgody.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
